# Optional bootstrap on first boot (skip the setup screen)
SYNCIDIAN_BOOTSTRAP_USER=admin
SYNCIDIAN_BOOTSTRAP_PASSWORD=change-me-now
SYNCIDIAN_PUBLIC_URL=http://localhost:8080

# Railway injects PORT and, with a volume attached, RAILWAY_VOLUME_MOUNT_PATH.
# Mount the Railway volume at /data before the first admin/GitHub App setup.
# Without it, every deploy wipes users, GitHub configuration, and vault files.
# Do not add a Docker VOLUME instruction — Railway rejects it; use a Railway Volume.
# railway.json requires that /data mount (requiredMountPath).
