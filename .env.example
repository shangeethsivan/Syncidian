# Optional bootstrap on first boot (skip the setup screen)
SYNCIDIAN_BOOTSTRAP_USER=admin
SYNCIDIAN_BOOTSTRAP_PASSWORD=change-me-now
SYNCIDIAN_PUBLIC_URL=http://localhost:8080

# Railway injects PORT and, with a volume attached, RAILWAY_VOLUME_MOUNT_PATH.
# Mount the Railway volume at /data (matches the image default). Do not add a
# Docker VOLUME instruction — Railway rejects it; use a Railway Volume instead.
