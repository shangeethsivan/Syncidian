# Optional bootstrap on first boot (skip the setup screen)
SYNCIDIAN_BOOTSTRAP_USER=admin
SYNCIDIAN_BOOTSTRAP_PASSWORD=change-me-now
SYNCIDIAN_PUBLIC_URL=http://localhost:8080

# Self-host: skip Tailscale. Open http://localhost:8080/admin
# SYNCIDIAN_ADMIN_PRIVATE=0
# Optional Tailscale-only operator hostname (hosted / CGNAT). Leave unset to skip.
# SYNCIDIAN_ADMIN_HOST=admin.syncidian.com
# SYNCIDIAN_ADMIN_LISTEN_IP=100.64.1.2
# Docker publish only on that IP (bridge network). Empty = 0.0.0.0.
# SYNCIDIAN_BIND_IP=100.64.1.2

# Railway injects PORT and, with a volume attached, RAILWAY_VOLUME_MOUNT_PATH.
# Mount the Railway volume at /data before the first admin/GitHub App setup.
# Without it, every deploy wipes users, GitHub configuration, and vault files.
# Do not add a Docker VOLUME instruction — Railway rejects it; use a Railway Volume.
# railway.json requires that /data mount (requiredMountPath).
# Optional: 32-byte hex or base64 key used to encrypt GitHub App PEM and
# installation tokens at rest. If unset, the server writes data/secret.key.
# SYNCIDIAN_DATA_KEY=

# Restrict GitHub sign-in to these emails. Empty = anyone.
# Hosted Railway: keep this set until public launch so waitlist people you
# choose can sign in without opening GitHub OAuth to everyone.
# JSON array, commas, or one address per line all work:
# SYNCIDIAN_GITHUB_ALLOWED_EMAILS=["Shangeeth95@gmail.com","waitlist@example.com"]
# SYNCIDIAN_GITHUB_ALLOWED_EMAIL is still accepted as a singular alias.
# PRODUCTION: unset both so every GitHub account can sign in, and stop hiding
# the landing GitHub buttons (see AGENT.md).
# SYNCIDIAN_GITHUB_ALLOWED_EMAILS=["Shangeeth95@gmail.com"]

# Google Analytics 4 measurement ID for the public landing (hosted). Empty = off.
# Events: click_discord, click_github, join_waitlist, click_github_signin.
# SYNCIDIAN_GA_ID=G-XXXXXXXXXX
